# ===== Backend =====
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kawrexam:change-me@localhost:5432/kawrexam
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
CODE_HASH_PEPPER=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Comma-separated origins allowed by CORS. Leave empty when the console proxies /api (default).
CORS_ORIGINS=
# Set true in production (HTTPS)
COOKIE_SECURE=false

# ===== Developer Console =====
# URL the Next.js server proxies /api/* to
BACKEND_URL=http://localhost:3000

# ===== One-time bootstrap (scripts/create-developer.ts) - never commit real values =====
# DEV_EMAIL=
# DEV_NAME=
# DEV_PASSWORD=

# ===== docker compose only =====
POSTGRES_PASSWORD=
