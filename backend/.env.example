NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
CODE_HASH_PEPPER=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Empty is fine: the console proxies /api, so no CORS is needed.
CORS_ORIGINS=
# true only when the site is served over HTTPS. With plain HTTP the login cookie would not be set.
COOKIE_SECURE=false
